# Python bytecode and test caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Virtual environments and local IDE settings
.venv/
venv/
env/
.vscode/
.idea/
*.swp
*.swo

# Secrets and local configuration
.env
.env.*
!.env.example
.streamlit/secrets.toml
secrets.toml
credentials.json
token.json

# Model weights (distribute separately when appropriate)
*.pth
*.pt
*.onnx

# Downloaded image datasets
data/raw/train/*.png
data/raw/val/*.png
data/test_benchmark/*.png
data/processed/*
!data/raw/train/.gitkeep
!data/raw/val/.gitkeep
!data/test_benchmark/.gitkeep
!data/processed/.gitkeep
!data/DATASET_SPEC.md

# Generated baseline artifacts
results/figures/*
results/tables/*
results/logs/*
!results/figures/.gitkeep
!results/tables/.gitkeep
!results/logs/.gitkeep

# OS files
.DS_Store
Thumbs.db
